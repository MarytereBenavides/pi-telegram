{
  "name": "pi-telegram",
  "version": "0.1.0",
  "private": false,
  "description": "Telegram DM bridge extension for pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "telegram",
    "bot",
    "extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/badlogic/pi-telegram.git"
  },
  "homepage": "https://github.com/badlogic/pi-telegram",
  "bugs": {
    "url": "https://github.com/badlogic/pi-telegram/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:offline-responder": "python3 tools/offline-responder/test_offline_responder.py",
    "typecheck": "npx -y -p typescript@5 tsc -p ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  }
}
